+
+std::function<int(const Eigen::Matrix4f&, unsigned long long)> System::GetRecoveryCandidateCheck()
+{
+    std::lock_guard<std::mutex> lock(recovery_check_mutex);
+    auto it = recovery_checks.find(mpTracker);
+    return it == recovery_checks.end() ? std::function<int(const Eigen::Matrix4f&, unsigned long long)>() : it->second;
+}
+
+bool System::GetLatestInertialBodyState(Eigen::Matrix4f& Twb, Eigen::Vector3f& velocity,
+                                        Eigen::Matrix<float,6,1>& bias, bool& ba2)
+{
+    if (!mpTracker || !mpAtlas) return false;
+    Map* map = mpAtlas->GetCurrentMap();
+    if (!map) return false;
+    unique_lock<mutex> map_lock(map->mMutexMapUpdate);
+    if (!map->isImuInitialized() || mpTracker->mState != Tracking::OK || !mpTracker->mCurrentFrame.HasPose() ||
+        !mpTracker->mCurrentFrame.HasVelocity()) return false;
+    Frame& frame = mpTracker->mCurrentFrame;
+    Twb = Eigen::Matrix4f::Identity();
+    Twb.block<3,3>(0,0) = frame.GetImuRotation();
+    Twb.block<3,1>(0,3) = frame.GetImuPosition();
+    velocity = frame.GetVelocity();
+    const IMU::Bias& b = frame.mImuBias;
+    bias << b.bax, b.bay, b.baz, b.bwx, b.bwy, b.bwz;
+    ba2 = map->GetIniertialBA2();
+    return Twb.allFinite() && velocity.allFinite() && bias.allFinite();
+}
