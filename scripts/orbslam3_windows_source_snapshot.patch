+    Map* map = mpAtlas->GetCurrentMap();
+    if (!map) return false;
+    unique_lock<mutex> map_lock(map->mMutexMapUpdate);
+    // VIBA2 结束后尺度才固定为米制；此前地图坐标是纯视觉的任意尺度。
+    return map->isImuInitialized() && map->GetIniertialBA2();
