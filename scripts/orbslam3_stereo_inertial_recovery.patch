+    // ---- IMU consistency guard for relocalization -------------------------
+    // Relocalization is a purely visual global PnP step: it may land anywhere in
+    // the map. Once the map is metric (IMU initialized) we can reject poses that
+    // are physically impossible from the last trusted pose, the gyro-integrated
+    // body rotation and a bounded translational speed. Rejected candidates keep
+    // the system LOST instead of teleporting the camera.
+    constexpr double kMaxRelocGapSec = 2.0;
+    constexpr double kRelocTransBaseM = 0.30;
+    constexpr double kRelocSpeedMps = 2.0;
+    constexpr double kRelocRotBaseDeg = 25.0;
+    constexpr double kRelocRotRateDegS = 90.0;
+
+    const bool bInertialSensor = (mSensor == System::IMU_STEREO || mSensor == System::IMU_RGBD ||
+                                  mSensor == System::IMU_MONOCULAR);
+    bool bCanPredict = false;
+    double dRelocGap = 0.0;
+    Sophus::SE3f TwcLast;
+    Eigen::Matrix3f dRpred = Eigen::Matrix3f::Identity();
+    if(bInertialSensor && mpAtlas->GetCurrentMap()->isImuInitialized() &&
+       mLastFrame.isSet())
+    {
+        dRelocGap = mCurrentFrame.mTimeStamp - mLastFrame.mTimeStamp;
+        if(dRelocGap > 1e-4 && dRelocGap <= kMaxRelocGapSec)
+        {
+            Eigen::Matrix3f Rinc = Eigen::Matrix3f::Identity();
+            for(size_t k = 0; k + 1 < mvImuFromLastFrame.size(); ++k)
+            {
+                const IMU::Point& u0 = mvImuFromLastFrame[k];
+                const IMU::Point& u1 = mvImuFromLastFrame[k + 1];
+                const double dt = double(u1.t) - double(u0.t);
+                if(dt <= 0.0)
+                    continue;
+                const Eigen::Vector3f w = 0.5f * (u0.w + u1.w) -
+                    Eigen::Vector3f(mLastBias.bwx, mLastBias.bwy, mLastBias.bwz);
+                const float ang = w.norm() * static_cast<float>(dt);
+                if(ang > 1e-9f)
+                    Rinc = Rinc * Eigen::AngleAxisf(ang, w.normalized()).toRotationMatrix();
+            }
+            // mTcb maps body -> camera (T_cb); R_wc = R_wb * R_cb.
+            const Eigen::Matrix3f Rcb = mCurrentFrame.mImuCalib.mTcb.rotationMatrix();
