+void System::ExportMap(const string &atlasFile, const string &poseFile)
+{
+    Shutdown();
+    mptLocalMapping->join();
+    mptLoopClosing->join();
+
+    const auto maps = mpAtlas->GetAllMaps();
+    if(maps.size() != 1 || maps.front()->KeyFramesInMap() < 2)
+        throw std::runtime_error("Scan must contain one connected map with at least two keyframes");
+    Map* map = maps.front();
+
+    std::ofstream poses(std::filesystem::u8path(poseFile));
+    poses.exceptions(std::ios::failbit | std::ios::badbit);
+    poses << std::setprecision(16);
+    auto ref = mpTracker->mlpReferences.begin();
+    auto stamp = mpTracker->mlFrameTimes.begin();
+    auto lost = mpTracker->mlbLost.begin();
+    for(const auto &relative : mpTracker->mlRelativeFramePoses)
+    {
+        KeyFrame* keyframe = *ref++;
+        const double time = *stamp++;
+        const bool wasLost = *lost++;
+        if(wasLost || !keyframe)
+            continue;
+        Sophus::SE3f culledToParent;
+        while(keyframe && keyframe->isBad())
+        {
+            culledToParent = culledToParent * keyframe->mTcp;
+            keyframe = keyframe->GetParent();
+        }
+        if(!keyframe || keyframe->GetMap() != map)
+            continue;
+        const Eigen::Matrix4f pose = (relative * culledToParent * keyframe->GetPose()).inverse().matrix();
+        poses << time << ' ' << map->GetId();
+        for(int row = 0; row < 3; ++row)
+            for(int col = 0; col < 4; ++col)
+                poses << ' ' << pose(row, col);
+        poses << '\n';
+    }
+    poses.close();
+
+    mpAtlas->PreSave();
+    std::ofstream atlas(std::filesystem::u8path(atlasFile), std::ios::binary);
+    atlas.exceptions(std::ios::failbit | std::ios::badbit);
+    {
+        boost::archive::binary_oarchive archive(atlas);
+        const auto name = std::filesystem::u8path(mStrVocabularyFilePath).filename().u8string();
+        archive << name;
+        archive << CalculateCheckSum(mStrVocabularyFilePath, TEXT_FILE);
+        archive << mpAtlas;
+    }
+    atlas.close();
+}
